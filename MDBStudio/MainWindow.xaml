<Window x:Class="MDBStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MDB Studio | Database Workspace" Icon="Assets/Logo.png"
        Height="850" Width="1450" MinHeight="650" MinWidth="1100"
        Background="#F3F7FC" FontFamily="Segoe UI" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Brand" Color="#0867D7"/>
    <SolidColorBrush x:Key="Ink" Color="#172C4B"/>
    <SolidColorBrush x:Key="Quiet" Color="#667A96"/>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#173A69"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="92"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="#CFDDEE" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E8F2FD"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Background" Value="#0969DA"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#0754AD"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#CBD9E9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Foreground" Value="#183455"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="BorderBrush" Value="#CBD9E9"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Foreground" Value="#173A69"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="HeadersVisibility" Value="All"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E5ECF5"/>
      <Setter Property="VerticalGridLinesBrush" Value="#E5ECF5"/>
      <Setter Property="AlternatingRowBackground" Value="#F5F9FE"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="ColumnHeaderHeight" Value="40"/>
      <Setter Property="RowHeight" Value="30"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="EnableColumnVirtualization" Value="True"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Foreground" Value="#244D79"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="82"/>
      <RowDefinition Height="102"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#D8E3F0" BorderThickness="0,0,0,1">
      <Grid Margin="19,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/Logo.png" Width="51" Height="51" Margin="0,0,12,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MDB Studio" FontSize="26" FontWeight="Bold" Foreground="#1254AE"/>
            <TextBlock Text="Explore. Edit. Organize." FontSize="11" Foreground="#7385A1"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="DatabaseTitle" Text="No database opened" FontSize="17" FontWeight="SemiBold" Foreground="#203752"/>
          <TextBlock x:Name="FileLabel" Text="Open an MDB or ACCDB file to begin" FontSize="11" Foreground="#7B8DA6" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#ECF6FE" CornerRadius="6" Padding="10,7" Margin="4,0">
            <TextBlock x:Name="VersionLabel" Text="MDB Studio" FontSize="11" Foreground="#2467A8"/>
          </Border>
          <Button x:Name="CheckUpdatesButton" Style="{StaticResource ToolButton}" Click="CheckUpdates_Click" Content="Check &amp; install updates"/>
          <Button x:Name="InstallDetailsButton" Style="{StaticResource ToolButton}" Click="InstallationDetails_Click"
                  Content="Installation details" ToolTip="Show the actual installed version, executable location and update log"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="12,9,12,8" Background="White" CornerRadius="11"
            BorderThickness="1" BorderBrush="#DBE6F2">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4">
          <Button Style="{StaticResource BlueButton}" Click="Open_Click">
            <StackPanel><TextBlock Text="▣" FontSize="21" TextAlignment="Center"/><TextBlock Text="Open database" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="CreateDatabaseButton" Style="{StaticResource ToolButton}" Click="CreateDatabase_Click"
                  ToolTip="Create a new blank MDB or ACCDB database without overwriting existing files">
            <StackPanel><TextBlock Text="＋" FontSize="21" TextAlignment="Center"/><TextBlock Text="New database" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="NewTableButton" Style="{StaticResource ToolButton}" Click="CreateTable_Click" IsEnabled="False"
                  ToolTip="Create an Access table and choose its fields, data types and primary key">
            <StackPanel><TextBlock Text="▥" FontSize="21" TextAlignment="Center"/><TextBlock Text="Create table" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="SchemaButton" Style="{StaticResource ToolButton}" Click="ManageSchema_Click" IsEnabled="False"
                  ToolTip="Create tables, design fields and primary keys, manage indexes and relationships">
            <StackPanel><TextBlock Text="▤" FontSize="21" TextAlignment="Center"/><TextBlock Text="Tables &amp; fields" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="AssociateFilesButton" Style="{StaticResource ToolButton}" Click="AssociateFiles_Click"
                  ToolTip="Make MDB Studio available in Windows Open With, then choose it in Default Apps">
            <StackPanel><TextBlock Text="↗" FontSize="21" TextAlignment="Center"/><TextBlock Text="Open with setup" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Click="Save_Click" IsEnabled="False">
            <StackPanel><TextBlock Text="▣" FontSize="21" TextAlignment="Center"/><TextBlock Text="Save changes" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="BackupButton" Style="{StaticResource ToolButton}" Click="Backup_Click" IsEnabled="False">
            <StackPanel><TextBlock Text="◫" FontSize="21" TextAlignment="Center"/><TextBlock Text="Backup" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="Export_Click" IsEnabled="False">
            <StackPanel><TextBlock Text="⇧" FontSize="21" TextAlignment="Center"/><TextBlock Text="Export all CSV" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="ImportExcelButton" Style="{StaticResource ToolButton}" Click="ImportExcel_Click" IsEnabled="False"
                  ToolTip="Import .xlsx or .csv data into a new MDB table or append to an existing table.">
            <StackPanel><TextBlock Text="▦" FontSize="21" TextAlignment="Center"/><TextBlock Text="Import Excel/CSV" FontSize="11"/></StackPanel>
          </Button>
          <Border Width="1" Height="58" Background="#DDE6F3" Margin="10,0"/>
          <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" Click="CopyCells_Click" IsEnabled="False" ToolTip="Copy selected cells (Ctrl+C)">
            <StackPanel><TextBlock Text="▤" FontSize="21" TextAlignment="Center"/><TextBlock Text="Copy cells" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="PasteButton" Style="{StaticResource ToolButton}" Click="PasteCells_Click" IsEnabled="False" ToolTip="Paste into selected cells, repeating a single value across your selection (Ctrl+V)">
            <StackPanel><TextBlock Text="▥" FontSize="21" TextAlignment="Center"/><TextBlock Text="Paste cells" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="FillDownButton" Style="{StaticResource ToolButton}" Click="FillDown_Click" IsEnabled="False" ToolTip="Fill selected column cells using the value in the topmost selected cell (Ctrl+D)">
            <StackPanel><TextBlock Text="▧" FontSize="21" TextAlignment="Center"/><TextBlock Text="Fill down" FontSize="11"/></StackPanel>
          </Button>
          <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="DeleteRecords_Click" IsEnabled="False"
                  ToolTip="Delete entire records in the selected rows. Select cells or row headers, then click (Ctrl+Delete).">
            <StackPanel><TextBlock Text="✕" FontSize="21" TextAlignment="Center" Foreground="#D44B55"/><TextBlock Text="Delete records" FontSize="11"/></StackPanel>
          </Button>
          <Border Width="1" Height="58" Background="#DDE6F3" Margin="10,0"/>
          <Button Style="{StaticResource ToolButton}" Click="Reload_Click">
            <StackPanel><TextBlock Text="↻" FontSize="21" TextAlignment="Center"/><TextBlock Text="Reload table" FontSize="11"/></StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="12,0,12,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="11" BorderBrush="#DBE6F2" BorderThickness="1">
        <DockPanel Margin="11,10">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="TABLES" Foreground="#24456A" FontWeight="Bold" FontSize="13" Margin="6,4,0,9"/>
            <TextBox x:Name="TableSearchBox" ToolTip="Search table names" TextChanged="TableSearch_TextChanged" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10">
              <Button x:Name="SidebarCreateTableButton" Content="Create table" Click="CreateTable_Click"
                      IsEnabled="False" Padding="8,6" Margin="0,0,6,0"/>
              <Button x:Name="SidebarDesignViewButton" Content="Design view" Click="ManageSchema_Click"
                      IsEnabled="False" Padding="8,6"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="2,8">
            <Border Background="#F1F7FF" Padding="10" CornerRadius="7">
              <TextBlock Text="Changes are backed up before the first save. Work on a copy of valuable databases." TextWrapping="Wrap" Foreground="#6A7F9C" FontSize="11"/>
            </Border>
          </StackPanel>
          <ListBox x:Name="TableList" SelectionChanged="TableList_SelectionChanged" BorderThickness="0"
                   Foreground="#25496F" FontSize="12" Background="White">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="9,8"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEEFF"/><Setter Property="Foreground" Value="#075BAF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="11" BorderBrush="#DBE6F2" BorderThickness="1">
        <TabControl x:Name="WorkspaceTabs" Margin="8">
          <TabItem Header="Table Data">
            <DockPanel Margin="6">
              <Grid DockPanel.Dock="Top" Margin="0,4,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="TableLabel" Text="Choose a table to browse" FontSize="18" FontWeight="Bold" Foreground="#183E71"/>
                  <TextBlock x:Name="KeyLabel" Text="Open a database to get started" Margin="0,4,0,0" FontSize="11" Foreground="#7186A3"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Search displayed rows" Foreground="#7386A2" FontSize="10" Margin="1,0,0,2"/>
                  <TextBox x:Name="RecordSearchBox" TextChanged="RecordSearch_TextChanged" ToolTip="Search text columns on the current page"/>
                </StackPanel>
              </Grid>
              <Border x:Name="EmptyDatabasePanel" DockPanel.Dock="Top" Visibility="Collapsed"
                      Background="#F3F8FF" BorderBrush="#C9DEF5" BorderThickness="1"
                      CornerRadius="9" Padding="18,15" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Your database is ready for its first table"
                             FontSize="16" FontWeight="SemiBold" Foreground="#174A83"/>
                  <TextBlock Text="Create a table, choose its field types and primary key, then enter records in Datasheet View. You can also import a spreadsheet to create a table."
                             TextWrapping="Wrap" Foreground="#526D8B" Margin="0,7,0,12"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BlueButton}" Content="Create first table"
                            Click="CreateTable_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="Import Excel or CSV"
                            Click="ImportExcel_Click" Margin="9,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border DockPanel.Dock="Top" Background="#F1F7FF" BorderBrush="#D8E6F5"
                      BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,10">
                <StackPanel>
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Filter column" Foreground="#264D7A" FontWeight="SemiBold"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <ComboBox x:Name="FilterColumnCombo" Width="190" IsEnabled="False" Margin="0,0,9,0"
                              SelectionChanged="FilterColumn_SelectionChanged"
                              ToolTip="Choose any database column, or click a grid header to select it"/>
                    <ComboBox x:Name="FilterOperationCombo" Width="137" IsEnabled="False" Margin="0,0,9,0"
                              DisplayMemberPath="Label" SelectionChanged="FilterOperation_SelectionChanged"/>
                    <ComboBox x:Name="FilterValueCombo" Width="235" IsEnabled="False" IsEditable="True"
                              IsTextSearchEnabled="True" Margin="0,0,9,0"
                              ToolTip="Select a suggested value from the full table or type any value"/>
                    <Button x:Name="ApplyColumnFilterButton" Style="{StaticResource BlueButton}"
                            Content="Apply" IsEnabled="False" Click="ApplyColumnFilter_Click"/>
                    <Button x:Name="RemoveColumnFilterButton" Style="{StaticResource ToolButton}"
                            Content="Remove selected" IsEnabled="False" Click="RemoveColumnFilter_Click"/>
                    <Button x:Name="ClearColumnFiltersButton" Style="{StaticResource ToolButton}"
                            Content="Clear all" IsEnabled="False" Click="ClearColumnFilters_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="ActiveFiltersLabel" Text="No active filters. Click a column header to choose a filter."
                             Margin="2,7,0,0" FontSize="11" Foreground="#526D8B" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border DockPanel.Dock="Bottom" Background="#F7FAFE" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Rows per page" VerticalAlignment="Center" FontSize="11" Foreground="#536A87" Margin="0,0,8,0"/>
                  <ComboBox x:Name="PageSizeCombo" Width="115" SelectedIndex="1" SelectionChanged="PageSize_SelectionChanged">
                    <ComboBoxItem Content="1,000" Tag="1000"/>
                    <ComboBoxItem Content="5,000" Tag="5000"/>
                    <ComboBoxItem Content="10,000" Tag="10000"/>
                    <ComboBoxItem Content="All records" Tag="0"/>
                  </ComboBox>
                  <Button x:Name="PreviousPageButton" Style="{StaticResource ToolButton}" Content="◀ Previous" Margin="10,0,0,0" Padding="8,5" Click="PreviousPage_Click" IsEnabled="False"/>
                  <Button x:Name="NextPageButton" Style="{StaticResource ToolButton}" Content="Next ▶" Padding="8,5" Click="NextPage_Click" IsEnabled="False"/>
                  <TextBlock x:Name="PageInfoLabel" Text="No table selected" Margin="13,0,0,0" VerticalAlignment="Center" Foreground="#365879" FontSize="11"/>
                </StackPanel>
              </Border>
              <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="True" CanUserAddRows="False"
                        CanUserDeleteRows="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                        SelectedCellsChanged="RecordsSelection_Changed" Sorting="RecordsGrid_Sorting"
                        PreviewKeyDown="RecordsGrid_PreviewKeyDown"
                        PreviewMouseRightButtonDown="RecordsGrid_PreviewMouseRightButtonDown"
                        Background="White" FontSize="12">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy selected cells" Click="CopyCells_Click"/>
                    <MenuItem Header="Paste into selected cells" Click="PasteCells_Click"/>
                    <MenuItem Header="Fill selected cells down" Click="FillDown_Click"/>
                    <Separator/>
                    <MenuItem Header="Clear selected cell values (Delete)" Click="ClearCells_Click"/>
                    <MenuItem Header="Delete selected records (Ctrl+Delete)" Click="DeleteRecords_Click"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="SQL Query">
            <Grid Margin="12">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="135"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="Read-only SELECT queries. Action queries are disabled."
                         Foreground="#7186A3" Margin="0,0,0,12"/>
              <TextBox x:Name="SqlInput" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
                <Button x:Name="VisualQueryDesignerButton" Style="{StaticResource BlueButton}"
                        Content="Visual query designer" HorizontalAlignment="Left"
                        Click="VisualQueryDesigner_Click" Margin="0,0,9,0"/>
                <Button Style="{StaticResource BlueButton}" Content="Run SELECT query"
                        HorizontalAlignment="Left" Click="Query_Click"/>
                <Button x:Name="ExportQueryExcelButton" Style="{StaticResource ToolButton}"
                        Content="Export results to Excel (.xlsx)" Margin="15,0,0,0" IsEnabled="False"
                        Click="ExportQueryExcel_Click"/>
                <Button x:Name="ExportQueryCsvButton" Style="{StaticResource ToolButton}"
                        Content="Export results to CSV (.csv)" Margin="8,0,0,0" IsEnabled="False"
                        Click="ExportQueryCsv_Click"/>
              </StackPanel>
              <DataGrid x:Name="QueryGrid" Grid.Row="3" IsReadOnly="True"
                        AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#E8F2FD" BorderBrush="#D4E1F1" BorderThickness="0,1,0,0">
      <Grid Margin="17,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Ready. Open an MDB or ACCDB file."
                   Foreground="#356187" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="StatusRight" Grid.Column="1" Text="MDB Studio Preview" Foreground="#6E84A1"
                   FontSize="11" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
