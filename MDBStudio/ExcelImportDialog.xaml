<Window x:Class="MDBStudio.ExcelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Excel or CSV into MDB Studio"
        Width="940" Height="650" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F3F7FC" FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,15">
      <TextBlock Text="Import Excel or CSV data" FontSize="22" FontWeight="Bold" Foreground="#163F72"/>
      <TextBlock x:Name="SourceLabel" FontSize="12" Foreground="#617C9B" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Choose worksheet or CSV" FontWeight="SemiBold" Foreground="#254B74" Margin="0,0,0,5"/>
        <ComboBox x:Name="SheetCombo" Height="34" SelectionChanged="SheetChanged"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Import destination" FontWeight="SemiBold" Foreground="#254B74" Margin="0,0,0,5"/>
        <ComboBox x:Name="TargetCombo" Height="34" SelectionChanged="TargetChanged"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock Text="New table name (only when creating a new table)" Foreground="#254B74" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBox x:Name="NewTableBox" Height="34" Padding="9,5"/>
      <TextBlock x:Name="PreviewInfo" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#617C9B"
                 Text="Select a source to preview records before importing."/>
    </StackPanel>
    <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#D8E3F0" BorderThickness="1">
      <DockPanel Margin="12">
        <TextBlock Text="Data preview (first 30 rows)" FontWeight="SemiBold" Foreground="#254B74"
                   DockPanel.Dock="Top" Margin="0,0,0,10"/>
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" AlternatingRowBackground="#F4F8FD"/>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="4" Margin="0,15,0,0">
      <TextBlock DockPanel.Dock="Left" Text="Import commits records to the MDB immediately, after a database backup."
                 Foreground="#6B7B93" TextWrapping="Wrap" Width="510" VerticalAlignment="Center" FontSize="11"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="100" Height="36" IsCancel="True" Margin="0,0,9,0"/>
        <Button x:Name="ImportButton" Content="Import data" Width="125" Height="36" IsEnabled="False"
                IsDefault="True" Click="Import_Click" Background="#0867D7" Foreground="White" BorderThickness="0"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
