<Window x:Class="MDBStudio.DatabasePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database password" Width="480" Height="260"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F5F7FB"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Password required" FontWeight="SemiBold" FontSize="18" Foreground="#233656"/>
    <TextBlock x:Name="Explanation" Grid.Row="1" Margin="0,10,0,16"
               TextWrapping="Wrap" Foreground="#53647C"
               Text="This Access database appears password protected. Enter its existing password. MDB Studio cannot recover or bypass unknown passwords."/>
    <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="32"
                 VerticalContentAlignment="Center" MaxLength="255" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Width="86" Margin="0,0,8,0" Padding="8,6"/>
      <Button Content="Open database" IsDefault="True" Width="118" Padding="8,6" Click="Submit_Click"/>
    </StackPanel>
  </Grid>
</Window>
