<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/>
    <Compile Include="../MDBStudio/PasteIdentityCatalog.cs" Link="PasteIdentityCatalog.cs"/>
    <Compile Include="../MDBStudio/RecordClipboard.cs" Link="RecordClipboard.cs"/>
    <Compile Include="../MDBStudio/GridCellEditor.cs" Link="GridCellEditor.cs"/>
    <Compile Include="../MDBStudio/RecordDeletion.cs" Link="RecordDeletion.cs"/>
    <Compile Include="../MDBStudio/ExcelTransfer.cs" Link="ExcelTransfer.cs"/>
    <Compile Include="../MDBStudio/CsvTransfer.cs" Link="CsvTransfer.cs"/>
    <Compile Include="../MDBStudio/SpreadsheetImportValue.cs" Link="SpreadsheetImportValue.cs"/>
    <PackageReference Include="ClosedXML" Version="0.105.1"/>
  </ItemGroup>
</Project>
